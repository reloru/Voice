# Copy to .env and fill in.  .env is gitignored — never commit real values.
#
#   cp .env.example .env

# --- Required --------------------------------------------------------------

# From https://console.x.ai → API Keys
XAI_API_KEY=xai-...

# The `dispatch_signing_secret` returned once when the phone number's webhook
# is created. Without it this server cannot tell a real xAI call event from a
# forged one, and will refuse to start.
#
# For local development only, you may instead set ALLOW_UNSIGNED_WEBHOOKS=true.
XAI_WEBHOOK_SECRET=whsec_...

# --- Optional --------------------------------------------------------------

# development | production | test
NODE_ENV=development
LOG_LEVEL=info

HOST=0.0.0.0
PORT=8080

AGENT_CONFIG_PATH=agent.yaml
DATA_DIR=data

# Accept unsigned webhooks. Refused when NODE_ENV=production.
# ALLOW_UNSIGNED_WEBHOOKS=false

# Reject deliveries whose timestamp is further off than this, in seconds.
# WEBHOOK_TOLERANCE_SECONDS=300

# Simultaneous live calls this process will bridge.
# MAX_CONCURRENT_CALLS=10

# POST a JSON summary here when a call ends or a message is taken. Point it at
# a Zapier / Make / n8n hook, or your own endpoint, to get SMS or email alerts.
# NOTIFY_WEBHOOK_URL=https://example.com/hooks/voice-agent

# Bearer token for the read-only GET /calls and GET /messages endpoints. These
# expose transcripts, so the routes stay disabled unless this is set.
# Generate one with: openssl rand -hex 32
# DASHBOARD_TOKEN=

# Override the API base. You should not need this.
# XAI_API_BASE=https://api.x.ai
